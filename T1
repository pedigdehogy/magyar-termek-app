<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Magyar Termék Vásárlói Érzet-Index</title>
    <script src="https://tailwindcss.com"></script>
    <style>
        .sticky-header { position: sticky; top: 0; z-index: 50; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans min-h-screen pb-10">

    <!-- ÁLLANDÓAN LÁTHATÓ FŐ MUTATÓ -->
    <div id="main-header" class="sticky-header bg-white shadow-md p-4 transition-colors duration-300 border-b-4 border-gray-300">
        <div class="max-w-md mx-auto text-center">
            <h1 class="text-xs font-bold uppercase tracking-wider text-gray-400">Multik Összesített Magyar Termék Aránya (Vásárlói Érzet)</h1>
            <div id="total-percentage" class="text-6xl font-black my-1">--%</div>
            <p id="total-status" class="text-xs font-semibold">Adatok számítása...</p>
        </div>
    </div>

    <!-- FŐ TARTALOM -->
    <main class="max-w-md mx-auto px-4 mt-6">
        <p class="text-xs text-center text-gray-500 mb-6 italic">
            Tippeld meg tapasztalatod alapján, hány % volt a magyar termék! Ha az átlag 50% alatti, a bolt pirosat kap.
        </p>

        <!-- BOLTOK LISTÁJA -->
        <div id="stores-container" class="space-y-4">
            <!-- Dinamikus tartalom -->
        </div>
    </main>

    <script>
        // Kezdő adatok (Szimulált korábbi szavazatok: összesített % érték, szavazók száma)
        const storesData = [
            { id: 'lidl', name: 'Lidl', totalPercentSum: 1680, voteCount: 42 }, // ~40%
            { id: 'aldi', name: 'Aldi', totalPercentSum: 2340, voteCount: 39 }, // ~60%
            { id: 'spar', name: 'Spar / Interspar', totalPercentSum: 2850, voteCount: 45 }, // ~63%
            { id: 'tesco', name: 'Tesco', totalPercentSum: 1350, voteCount: 45 }, // ~30%
            { id: 'penny', name: 'Penny', totalPercentSum: 1800, voteCount: 40 }  // ~45%
        ];

        function updateApp() {
            let globalPercentSum = 0;
            let globalVoteCount = 0;
            const container = document.getElementById('stores-container');
            container.innerHTML = '';

            storesData.forEach(store => {
                // Bolt átlagának kiszámítása
                const storeAverage = store.voteCount > 0 ? Math.round(store.totalPercentSum / store.voteCount) : 0;
                
                globalPercentSum += store.totalPercentSum;
                globalVoteCount += store.voteCount;

                // Szabály: 50% alatt szigorúan piros a teljesítmény
                const isRed = storeAverage < 50;
                const percentageColor = isRed ? 'text-red-600' : 'text-green-600';
                const cardBorder = isRed ? 'border-red-200 bg-red-50/30' : 'border-gray-200 bg-white';

                const card = document.createElement('div');
                card.className = `rounded-xl shadow-sm p-4 border transition-all ${cardBorder}`;
                card.innerHTML = `
                    <div class="flex justify-between items-center mb-3">
                        <span class="text-lg font-bold text-gray-900">${store.name}</span>
                        <div class="text-right">
                            <span class="text-2xl font-black ${percentageColor}">${storeAverage}%</span>
                            <div class="text-[10px] text-gray-400">${store.voteCount} szavazat alapján</div>
                        </div>
                    </div>
                    
                    <div class="text-xs font-semibold text-gray-500 mb-2">Hány % magyar terméket láttál?</div>
                    <!-- Tipp gombok -->
                    <div class="grid grid-cols-4 gap-1.5">
                        <button onclick="addEstimate('${store.id}', 20)" class="bg-gray-100 hover:bg-red-500 hover:text-white transition py-1.5 px-1 rounded text-xs font-bold text-gray-700">20%</button>
                        <button onclick="addEstimate('${store.id}', 40)" class="bg-gray-100 hover:bg-orange-500 hover:text-white transition py-1.5 px-1 rounded text-xs font-bold text-gray-700">40%</button>
                        <button onclick="addEstimate('${store.id}', 60)" class="bg-gray-100 hover:bg-emerald-500 hover:text-white transition py-1.5 px-1 rounded text-xs font-bold text-gray-700">60%</button>
                        <button onclick="addEstimate('${store.id}', 80)" class="bg-gray-100 hover:bg-green-600 hover:text-white transition py-1.5 px-1 rounded text-xs font-bold text-gray-700">80%</button>
                    </div>
                `;
                container.appendChild(card);
            });

            // Országos összesített érzet-átlag kiszámítása
            const globalAverage = globalVoteCount > 0 ? Math.round(globalPercentSum / globalVoteCount) : 0;
            const headerElement = document.getElementById('main-header');
            const totalPctElement = document.getElementById('total-percentage');
            const totalStatusElement = document.getElementById('total-status');

            totalPctElement.innerText = globalAverage + '%';

            if (globalAverage >= 50) {
                headerElement.className = "sticky-header bg-white shadow-md p-4 transition-colors duration-300 border-b-4 border-green-500";
                totalPctElement.className = "text-6xl font-black my-1 text-green-600";
                totalStatusElement.innerText = "A vásárlók szerint a polcok többségén magyar termék van.";
                totalStatusElement.className = "text-xs font-bold text-green-600";
            } else {
                headerElement.className = "sticky-header bg-white shadow-md p-4 transition-colors duration-300 border-b-4 border-red-500";
                totalPctElement.className = "text-6xl font-black my-1 text-red-600";
                totalStatusElement.innerText = "Kritikus szint! A vásárlói érzet szerint dominál az import áru.";
                totalStatusElement.className = "text-xs font-bold text-red-600";
            }
        }

        // Új vásárlói becslés hozzáadása
        function addEstimate(storeId, percent) {
            const store = storesData.find(s => s.id === storeId);
            if (store) {
                store.totalPercentSum += percent;
                store.voteCount++;
                updateApp();
            }
        }

        // Kezdő futtatás
        updateApp();
    </script>
</body>
</html>
